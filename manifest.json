{
  "manifest_version": 3,
  "name": "Textuary — Article Reader & Text Sanctuary",
  "short_name": "Textuary",
  "version": "2.8.0",
  "description": "A calm, private text sanctuary with article reading, a local library, typography, progress and read-aloud.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128-store.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "Open Textuary",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src https://huggingface.co https://*.huggingface.co https://*.hf.co https://*.xethub.hf.co"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/kokoro.web.js",
        "vendor/ort-wasm-simd-threaded.jsep.mjs",
        "vendor/ort-wasm-simd-threaded.jsep.wasm"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "Open the current article in Textuary"
    }
  },
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "15.4"
    }
  }
}
